# Supabase Configuration for Monopoly3D Online Multiplayer
# Copy this file to .env.local and fill in your Supabase project credentials

# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings > API and copy:
#    - Project URL → VITE_SUPABASE_URL
#    - anon/public key → VITE_SUPABASE_ANON_KEY
# 3. Go to SQL Editor in Supabase dashboard
# 4. Run the SQL from: src/multiplayer/supabase.sql
# 5. Copy this file to .env.local with your actual credentials
# 6. Restart the dev server

# ============================================
# OPTIONAL: Supabase Auth Settings
# ============================================

# For anonymous authentication to work, make sure in your Supabase project:
# Authentication > Providers > Anonymous Sign-ins is enabled
